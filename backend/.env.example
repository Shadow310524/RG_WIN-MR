# Application Configuration
PROJECT_NAME="RG WIN - Healix Field Sales & Doctor CRM"
VERSION=1.0.0
ENVIRONMENT=development
DEBUG=false
HOST=0.0.0.0
PORT=8000

# Security (Replace with a cryptographically secure 32+ byte string in production)
SECRET_KEY=rgwin-change-this-secret-in-production-env-min-32-chars
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=7

# Database Connection (PostgreSQL asyncpg)
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/rg_win_dev
DB_ECHO=false
DB_POOL_SIZE=10
DB_MAX_OVERFLOW=20

# Authoritative Healix Upstream API
HEALIX_API_BASE_URL=https://healix-rgwin.onrender.com/api/v1
HEALIX_API_TIMEOUT_SECONDS=15.0

# Rate Limiting
RATE_LIMIT_PER_MINUTE=60
